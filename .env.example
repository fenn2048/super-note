# ============================================================
# super-note 环境变量模板（可选）
# ------------------------------------------------------------
# 绝大多数用户不需要这个文件 —— 容器首次启动时会自动生成并持久化
# 一个随机 JWT_SECRET 到 data 卷（/app/data/.jwt_secret），下次启动
# 自动复用。
#
# 什么时候你需要手动维护 .env：
#   · 多实例部署要共用同一个 JWT_SECRET（如负载均衡后的水平扩容）
#   · 希望统一用企业的密钥管理平台签发
#   · 想要自己控制密钥轮换节奏
#
# 使用方式：
#   1. 复制本文件为同目录下的 .env   (cp .env.example .env)
#   2. 填入下方各项真实值
#   3. docker compose up -d
#
# .env 已在 .gitignore 中，绝不会被提交到仓库。
# ============================================================

# JWT 登录 / sudo token 的签名密钥，长度 >= 16
# 生成方式：openssl rand -base64 48
# JWT_SECRET=

# 分享 token 的独立签名密钥（未设置时从 JWT_SECRET 派生）
# SHARE_JWT_SECRET=

# Ollama 服务地址（AI 能力）。不使用 AI 时留空。
# Docker 内访问宿主机：http://host.docker.internal:11434
# OLLAMA_URL=

# Redis 连接地址（多实例广播 / AI 异步任务队列）。
# 不设置、或设为 memory / off 时，使用进程内 memory 模式（单实例足够，本地 dev 无需 Redis）。
# 多实例部署时必须配置真实 Redis：
# REDIS_URL=redis://127.0.0.1:6379

# CORS 白名单（逗号分隔完整 origin）。生产环境跨域访问时强烈建议配置。
# 未配置时：无 Origin 请求放行；localhost/127.0.0.1 放行；其它 Origin 拒绝反射。
# ALLOWED_ORIGINS=https://note.example.com,http://localhost:5173
